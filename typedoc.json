{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "name": "Journalism Finance",
  "includeVersion": true,
  "validation": {
    "notDocumented": true
  },
  "requiredToBeDocumented": ["Function", "Class", "Method", "Accessor"],
  "treatValidationWarningsAsErrors": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-llms-txt", "typedoc-github-theme"],
  "hostedBaseUrl": "https://nshiab.github.io/journalism-finance/",
  "outputs": [
    {
      "name": "markdown",
      "path": ".",
      "options": {
        "theme": "default",
        "router": "module",
        "entryFileName": "llm.md",
        "mergeReadme": true,
        "cleanOutputDir": false,
        "llmsTxt": false
      }
    },
    {
      "name": "markdown",
      "path": "docs",
      "options": {
        "theme": "default",
        "entryFileName": "index.md",
        "out": "docs",
        "llmsTxtHeader": {
          "features": ["[README](../README.md): Installation, examples and usage."]
        }
      }
    },
    {
      "name": "html",
      "path": "site",
      "options": {
        "llmsTxt": false
      }
    }
  ],
  "disableSources": true
}
